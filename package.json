{
  "name": "@astrixmh/devctx",
  "version": "0.1.4",
  "description": "Project decision memory for AI coding tools: captures corrections through tool hooks, consolidates them in git, and delivers them to every tool at session start and per prompt.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhlee-lee/devctx.git"
  },
  "homepage": "https://github.com/mhlee-lee/devctx#readme",
  "bugs": {
    "url": "https://github.com/mhlee-lee/devctx/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "devctx": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "data",
    "vendor",
    "THIRD_PARTY.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:memory": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/memory-bench.ts",
    "dev": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "bench:codeindex": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/codeindex-smoke.ts"
  },
  "dependencies": {
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  }
}
